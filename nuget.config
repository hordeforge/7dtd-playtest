<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only nuget.org. <clear /> drops user/machine feeds so restore cannot
       pick a same-named package from an extra source. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
