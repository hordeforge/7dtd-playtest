.venv/
__pycache__/
.pytest_cache/
dist/
Source/PlayTestMod/bin/
Source/PlayTestMod/obj/

# playtest-compare run dirs: keep the reports, ignore the run state.
workspace/comparison-playtest/*/stock/
workspace/comparison-playtest/*/zdtd/
.local/
*.flock
*.lock
# uv.lock matches the rule above, and it is the file every `uv run --locked`
# gate depends on: regenerating it and re-adding would need -f, which is how a
# committed lockfile quietly goes missing.
!uv.lock
.coverage
.coverage.*
htmlcov/

# Scratch: every temporary, experimental, or bisect file lives here and is
# never committed. See the org REPOSITORY_STANDARDS.md.
.scratch/
.scratch_*
